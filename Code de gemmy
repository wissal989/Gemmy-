 import pygame
from tkinter import *
from tkinter import messagebox
import os

root = Tk()
root.title("جيمي - التذكيرات")

# تهيئة الصوت
pygame.mixer.init()

def show_reminder(message, sound_file):
    messagebox.showinfo("تذكير", message)
    if os.path.exists(sound_file):
        pygame.mixer.music.load(sound_file)
        pygame.mixer.music.play()
    else:
        messagebox.showerror("خطأ", f"ملف الصوت '{sound_file}' غير موجود.")

def remind_eat():
    show_reminder("تذكر! حان وقت الأكل!", "eat_sound.mp3")
    # تذكير تلقائي بعد 3 ساعات (3 * 60 * 60 * 1000 ميلي ثانية)
    root.after(3 * 60 * 60 * 1000, remind_eat)

def remind_teeth():
    show_reminder("تذكر! حان وقت تنظيف أسنانك!", "teeth_sound.mp3")
    # تذكير تلقائي بعد 12 ساعة
    root.after(12 * 60 * 60 * 1000, remind_teeth)

def remind_sleep():
    show_reminder("تذكر! حان وقت النوم الآن!", "sleep_sound.mp3")
    root.after(24 * 60 * 60 * 1000, remind_sleep)

# أزرار يدوية للتجربة أو الاستخدام الفوري
button_eat = Button(root, text="وقت الأكل", command=remind_eat)
button_eat.pack(pady=10)

button_teeth = Button(root, text="وقت تنظيف الأسنان", command=remind_teeth)
button_teeth.pack(pady=10)

button_sleep = Button(root, text="وقت النوم", command=remind_sleep)
button_sleep.pack(pady=10)

# بدء التذكيرات التلقائية بعد بداية البرنامج مباشرة
root.after(5000, remind_eat)    # يبدأ بعد 5 ثوانٍ فقط للتجربة
root.after(10000, remind_teeth) # يبدأ بعد 10 ثوانٍ
root.after(15000, remind_sleep) # يبدأ بعد 15 ثانية

root.mainloop()
